# Agent Island spectator settings. Copy to .env.local and fill in.
# Every value here is public: Vite builds it into the page.

# The QuestFi contract on NEAR testnet. Leave empty and the market runs on
# simulated chips, as it does without a chain.
VITE_CONTRACT_ID=

# NEAR RPC endpoint. Default: https://test.rpc.fastnear.com
VITE_RPC_URL=https://test.rpc.fastnear.com

# The test account service (the start app's /api/guest). It receives only a
# public key and creates a funded testnet account for it. Default: /api/guest,
# which works when the start app is served from the same origin. In
# development the dev server forwards /api/guest to the start app's dev
# server on port 5177 (see vite.config.js).
VITE_GUEST_API=/api/guest

# The game server (quest-sim). Default: /api, proxied to 127.0.0.1:8000 in
# development.
VITE_BACKEND_URL=
