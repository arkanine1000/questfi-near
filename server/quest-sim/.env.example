# LLM Configuration (hosted agent brains; shared key/base for all models)
QUEST_SIM_LLM_MODEL=deepseek/deepseek-v4-flash
QUEST_SIM_LLM_API_BASE=
QUEST_SIM_LLM_API_KEY=

# Prompt-chan, the commentator — ON by default (unset the model to silence
# her; QUEST_SIM_COMMENTATOR_ENABLED=false is the kill switch that keeps
# the model configured).
QUEST_SIM_COMMENTATOR_MODEL=deepseek/deepseek-v4-flash
QUEST_SIM_COMMENTATOR_ENABLED=true

# Sandbox (multi-agent seasons) — all overridable per world via POST /world/new
QUEST_SIM_SANDBOX_POOL_SIZE=10
QUEST_SIM_SANDBOX_NUM_SITES=6
QUEST_SIM_SANDBOX_ACTION_DEADLINE_S=45.0
QUEST_SIM_SANDBOX_TICK_SECONDS=2.0
QUEST_SIM_SANDBOX_MAX_TICKS=300
# "llm" (the product) | "policy" (token-free rehearsal/CI)
QUEST_SIM_SANDBOX_HOSTED_BRAIN=llm
QUEST_SIM_SANDBOX_DATA_DIR=data/worlds

# Host controls — who may run a season.
#
# Every world minted by POST /world/new gets a host_key, returned once in
# that response; whoever holds it drives that season's clock and may delete
# it. QUEST_SIM_ADMIN_KEY is the operator's skeleton key over every world.
#
# ENFORCED off = the gate is installed but not armed (anyone can still drive
# any clock). That default exists so this backend can deploy ahead of a
# frontend that knows to send a key — turn it on once clients do. DELETE is
# gated either way.
#
# OPERATOR_ONLY is the lockdown switch for a public instance: ONLY the admin
# key may open a lobby or touch a clock, and per-world host keys go inert.
# Players are unaffected — they still join, ready up and take turns. The
# server REFUSES TO BOOT if this is on with no admin key set, because
# nothing could be created or run.
#QUEST_SIM_ADMIN_KEY=
QUEST_SIM_SANDBOX_HOST_KEY_ENFORCED=false
QUEST_SIM_SANDBOX_OPERATOR_ONLY=false

# Persistence
# Prefab quests are read from <parent>/quests, so this still matters.
QUEST_SIM_DATA_DIR=data/games

# Server
QUEST_SIM_HOST=0.0.0.0
QUEST_SIM_PORT=8000
# Tighten to the deployed frontend origin in production, e.g.
# ["https://your-app.vercel.app"]
QUEST_SIM_CORS_ORIGINS=["*"]

# Prompt-chan's voice — ElevenLabs proxy (/tts). Leave unset to fall back
# to the spectator browser's own Web Speech voice. Pick an anime-style
# voice in the ElevenLabs voice library and paste its voice id here.
#QUEST_SIM_TTS_API_KEY=xi-...
#QUEST_SIM_TTS_VOICE_ID=
#QUEST_SIM_TTS_MODEL=eleven_flash_v2_5
