# The contract and services the start app talks to. Without VITE_CONTRACT_ID
# the app runs its scripted demo (the same as adding ?mock to the address).
VITE_CONTRACT_ID=
VITE_RPC_URL=https://test.rpc.fastnear.com
VITE_GAME_URL=http://localhost:8000
VITE_WORLD_URL=http://localhost:5175/?nointro&alt=9000000

# Test accounts. Server side only: these are never sent to the browser.
# The account that creates and funds test accounts, and its private key.
QUESTFI_GUEST_PARENT_ID=
QUESTFI_GUEST_PARENT_KEY=
# NEAR each test account starts with, and the parent balance below which no
# more are made.
QUESTFI_GUEST_GRANT=0.5
QUESTFI_GUEST_FLOOR=1
